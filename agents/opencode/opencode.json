{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "agents/opencode/AGENTS.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "mcp"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "mcp",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "C:\\Users\\mathe\\AppData\\Local\\Programs\\codebase-memory-mcp\\codebase-memory-mcp.exe"
      ],
      "environment": {
        "CBM_CACHE_DIR": "C:\\Users\\mathe\\.cbm-state\\cache",
        "CBM_RUNTIME_DIR": "C:\\Users\\mathe\\.cbm-state\\runtime"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "environment": {
        "CHROME_DEBUGGING_PORT": "9222"
      },
      "enabled": true
    }
  }
}
