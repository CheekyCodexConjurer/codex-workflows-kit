{
  "name": "codex-workflows-local",
  "interface": {
    "displayName": "Codex Workflows Local"
  },
  "plugins": [
    {
      "name": "audiobook-codex",
      "source": {
        "source": "local",
        "path": "./plugins/audiobook-codex"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "mcp-foundation",
      "source": {
        "source": "local",
        "path": "./plugins/mcp-foundation"
      },
      "policy": {
        "installation": "INSTALLED_BY_DEFAULT",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    }
  ]
}
