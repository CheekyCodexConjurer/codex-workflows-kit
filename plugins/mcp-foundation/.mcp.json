{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 90,
      "default_tools_approval_mode": "approve"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "approve"
    },
    "openaiDeveloperDocs": {
      "type": "http",
      "url": "https://developers.openai.com/mcp",
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "approve"
    }
  }
}
